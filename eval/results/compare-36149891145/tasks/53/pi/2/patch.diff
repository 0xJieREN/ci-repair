@@ -0,0 +1,73 @@
+from .common import InfoExtractor
+from ..utils import (
+    int_or_none,
+    unified_timestamp,
+    url_or_none,
+)
+
+
+class EllenTubeIE(InfoExtractor):
+    _VALID_URL = r'''(?x)
+        (?:
+            ellentube:|
+            https?://(?:www\.)?ellentube\.com/(?:video/|embed/)
+        )
+        (?P<id>[\w-]+)
+    '''
+    _TESTS = []
+
+    def _call_api(self, path, video_id, query=None):
+        return self._download_json(
+            f'https://api-prod.ellentube.com/{path}', video_id, query=query, fatal=False) or {}
+
+    def _extract_video(self, video, video_id):
+        formats = []
+        for rendition in (video.get('videos') or []):
+            if not isinstance(rendition, dict):
+                continue
+            format_url = url_or_none(rendition.get('url'))
+            if not format_url:
+                continue
+            formats.append({
+                'url': format_url,
+                'format_id': rendition.get('type') or rendition.get('label'),
+                'width': int_or_none(rendition.get('width')),
+                'height': int_or_none(rendition.get('height')),
+            })
+
+        return {
+            'id': video_id,
+            'title': video.get('title'),
+            'description': video.get('description'),
+            'thumbnail': url_or_none(video.get('image') or video.get('thumbnail')),
+            'timestamp': unified_timestamp(
+                video.get('published_at') or video.get('publishedAt')),
+            'duration': int_or_none(video.get('duration')),
+            'formats': formats,
+        }
+
+    def _real_extract(self, url):
+        video_id = self._match_id(url)
+        video = self._call_api(f'v1/videos/{video_id}', video_id)
+        return self._extract_video(video, video_id)
+
+
+class EllenTubeVideoIE(EllenTubeIE):
+    _VALID_URL = r'https?://(?:www\.)?ellentube\.com/video/(?P<id>[\w-]+)'
+    _TESTS = []
+
+
+class EllenTubePlaylistIE(EllenTubeIE):
+    _VALID_URL = r'https?://(?:www\.)?ellentube\.com/playlist/(?P<id>[\w-]+)'
+    _TESTS = []
+
+    def _real_extract(self, url):
+        playlist_id = self._match_id(url)
+        playlist = self._call_api(f'v1/playlists/{playlist_id}', playlist_id)
+        entries = []
+        for video in (playlist.get('videos') or []):
+            if not isinstance(video, dict) or not video.get('id'):
+                continue
+            entries.append(self._extract_video(video, video['id']))
+        return self.playlist_result(
+            entries, playlist_id, playlist.get('title'), playlist.get('description'))
